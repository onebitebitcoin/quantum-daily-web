<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  quantum-daily-web 수집 스케줄. **매일** 돈다 — 발행은 주 1회지만 후보 창이 7일이라
  매일 갱신해 두어야 일요일에 소스가 죽어 있어도 그 주가 통째로 비지 않는다.
  logs/collect-stats.tsv 에 일별 집계도 같이 쌓인다.

    cp deploy/com.nsw.quantum-collect.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.nsw.quantum-collect.plist

  06:40 인 이유: btc-daily 06:00, ai-daily 06:10 다음이다. 셋이 같은 소스 서버
  (:8000, :23456)를 두드리므로 겹치면 서로의 응답을 느리게 만든다.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.nsw.quantum-collect</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/Users/nsw/meeting_room/lab/quantum-daily-web/scripts/daily-collect.sh</string>
	</array>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>6</integer>
		<key>Minute</key>
		<integer>40</integer>
	</dict>

	<key>RunAtLoad</key>
	<false/>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/nsw/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOME</key>
		<string>/Users/nsw</string>
		<!-- /quantum 배포 후 프로덕션 주소로 바꾼다 -->
		<key>QUANTUM_DAILY_API</key>
		<string>http://localhost:8004</string>
	</dict>

	<key>StandardOutPath</key>
	<string>/Users/nsw/meeting_room/lab/quantum-daily-web/logs/collect-launchd.out</string>
	<key>StandardErrorPath</key>
	<string>/Users/nsw/meeting_room/lab/quantum-daily-web/logs/collect-launchd.err</string>
</dict>
</plist>
