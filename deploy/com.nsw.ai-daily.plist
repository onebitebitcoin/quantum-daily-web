<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ai-daily 무인 발행 스케줄. 이 파일은 **개발 머신(맥)** 에 설치한다 — 배포 서버가
  아니다. 수집 소스(my-news :8000, my-youtube :23456)가 맥에만 있어서, 수집과
  문구작성은 맥에서 하고 완성된 에디션만 프로덕션으로 POST 한다.

    cp deploy/com.nsw.ai-daily.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.nsw.ai-daily.plist

  발화 시각을 06:10 으로 둔 것은 btc-daily(com.nsw.btc-daily)가 06:00 이기 때문이다.
  둘 다 claude 를 부르고 같은 소스 서버(:8000, :23456)를 두드리므로 겹쳐 돌리면
  서로의 레이트리밋을 갉아먹는다. 10 분이면 btc 쪽이 끝나고도 남는다.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.nsw.ai-daily</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/Users/nsw/meeting_room/lab/ai-daily-web/scripts/daily-cron.sh</string>
	</array>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>6</integer>
		<key>Minute</key>
		<integer>10</integer>
	</dict>

	<key>RunAtLoad</key>
	<false/>

	<key>WorkingDirectory</key>
	<string>/Users/nsw/meeting_room/lab/ai-daily-web</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/nsw/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOME</key>
		<string>/Users/nsw</string>
	</dict>

	<key>StandardOutPath</key>
	<string>/Users/nsw/meeting_room/lab/ai-daily-web/logs/launchd.out</string>
	<key>StandardErrorPath</key>
	<string>/Users/nsw/meeting_room/lab/ai-daily-web/logs/launchd.err</string>
</dict>
</plist>
